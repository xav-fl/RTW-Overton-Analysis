. label define oa_status 1 "gold" 2 "diamond" 3 "hybrid" 4 "bronze"            ///
>     5 "green" 6 "closed"
r; t=0.00 12:22:18

. 
. foreach v in research_type emp_design primary_pc policy_studied item_type oa_status {
  2.     local lab : variable label `v'
  3.     encode `v', gen(`v'_n) label(`v') noextend
  4.     order `v'_n, after(`v')
  5.     drop `v'
  6.     rename `v'_n `v'
  7.     label variable `v' `"`lab'"'
  8. }
