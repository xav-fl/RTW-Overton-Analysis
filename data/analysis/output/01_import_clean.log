. *------------------------------------------------------------------------------
. * 2. Check the header row matches the map (fails if columns move or change)
. *------------------------------------------------------------------------------
. import excel using "`xlsx'", sheet("`sheet'") cellrange(A1:BO1) allstring clear
(67 vars, 1 obs)
r; t=0.14 12:22:17

. unab cols : _all
r; t=0.01 12:22:17

. assert `: word count `cols'' == `K'
r; t=0.00 12:22:17

. forvalues i = 1/`K' {
  2.     local c : word `i' of `cols'
  3.     local h "`h`i''"
  4.     if strtrim(`c'[1]) != `"`h'"' {
  5.         di as error `"Column `c': expected "`h'", found "`=`c'[1]'""'
  6.         exit 9
  7.     }
  8. }
r; t=0.00 12:22:17

. 
